# Namelivo — Environment Variables
#
# Copy this file to `.env` and fill in the values when they become available.
# On Netlify, set these in Site Settings → Environment Variables (not in the repo).
# Never commit real secrets to the repository.

# --- Supabase (auth + database) ---
# Already provisioned for this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Domain Registrar (NameSilo) ---
# API key is stored server-side only (Supabase Edge Function secrets).
# The browser never receives this value.
# NAMESILO_API_KEY=

# --- Payment Processor (PayPal) ---
# PayPal LIVE credentials are stored server-side only (Supabase Edge Function secrets).
# The browser never receives the secret values.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_RETURN_URL=
#
# Note: PayPal webhook signature verification uses the Webhook ID, not a
# separate secret. PAYPAL_WEBHOOK_SECRET is NOT required.
